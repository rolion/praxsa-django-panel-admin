ENV=PROD
DEBUG=0
SECRET_KEY=change-me-generate-a-unique-random-value-per-environment
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=praxsa
DB_HOST=db
DB_PORT=5432
TZ=America/La_Paz
PGTZ=America/La_Paz

# Contrasena de los usuarios que crea `inicializar_datos` (superadmin, admin1, admin2).
# Debe cumplir las reglas de contrasena de Django. Solo se usa al correr scripts/init-v2.sh.
DEFAULT_PASSWORD=change-me

# Hosts y origenes permitidos (listas separadas por coma). Sin dominio todavia: usar la IP
# o el nombre con que se accede a nginx. CSRF_TRUSTED_ORIGINS lleva esquema (http:// o https://).
ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx,change-me-ip-o-dominio
CSRF_TRUSTED_ORIGINS=http://change-me-ip-o-dominio
CORS_ORIGIN_WHITELIST=http://change-me-ip-o-dominio
