worker_processes 8;
user root;
error_log  /var/log/nginx/error.log;
pid /var/run/nginx.pid;
events {}
http {
    include mime.types;

    # Este nginx va detras de nginx-proxy (que termina TLS y manda
    # X-Forwarded-Proto). Se propaga ese valor a Django; $scheme aqui siempre
    # es http porque solo se escucha en :80.
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }
    upstream praxsa_server {
        server web:5000;
    }
    upstream praxsa_page {
        server proforma:4000;
    }

    server {

        listen 80;

        server_name panel.praxsasrl.store www.panel.praxsasrl.store;

        location /static/ { # copy your STATIC_URL here
            autoindex on;
            alias /praxsa_manager/staticfiles/; # copy your static file path here
        }

        location /media/ {
            alias /praxsa_manager/media/;
        }

        location / {
            root /etc/nginx/html/;
            index index.html index.htm;
            try_files $uri $uri/ /index.html =404;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $server_name;
            proxy_set_header Host $http_host;
            proxy_redirect off;
            proxy_pass http://praxsa_server;
        }
    }

    server {

        listen 80;

        server_name praxsasrl.store www.praxsasrl.store laminas.praxsasrl.store;

        location / {
            root /etc/nginx/html/;
            index index.html index.htm;
            try_files $uri $uri/ /index.html =404;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_redirect off;
            proxy_pass http://praxsa_page;
        }

    }
}