worker_processes 8;
user root;
error_log  /var/log/nginx/error.log;
pid /var/run/nginx.pid;
events {}
http {
    include mime.types;
    upstream praxsa_server {
        server web:5000;
    }
    upstream praxsa_page {
        server proforma:4000;
    }

    upstream praxsa_db_manager {
        server praxsa-adminer-1:8080;
    }

    server {

        listen 80;

        server_name panel.praxsasrl.store www.panel.praxsasrl.store;

        location /static/ { # copy your STATIC_URL here
            autoindex on;
            alias /praxsa_manager/staticfiles/; # copy your static file path here
        }

        location / {
            root /etc/nginx/html/;
            index index.html index.htm;
            try_files $uri $uri/ /index.html =404;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $server_name;
            proxy_set_header Host $http_host;
            proxy_redirect off;
            proxy_pass http://praxsa_server;
        }
    }

    server {

        listen 80;

        server_name praxsasrl.store www.praxsasrl.store laminas.praxsasrl.store;

        location / {
            root /etc/nginx/html/;
            index index.html index.htm;
            try_files $uri $uri/ /index.html =404;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Host $http_host;
            proxy_redirect off;
            proxy_pass http://praxsa_page;
        }

    }

    server {

        listen 80;

        server_name honey.praxsasrl.store;

        location / {
            proxy_pass http://praxsa_db_manager;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
        }

    }
}