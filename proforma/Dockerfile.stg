## Use Node Slim image
FROM node:18.16 as Builder

ENV HOME_DEV=/app/proforma
## Copy source code
COPY . $HOME_DEV
WORKDIR $HOME_DEV
RUN npm install -g @angular/cli@16.1.0
RUN npm i
RUN rm -r src/environments/environment.ts
COPY src/environments/environment.stg.ts ./src/environments/environment.ts
EXPOSE 4200
CMD ["ng","run", "proforma:serve-ssr"]


